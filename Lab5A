"""Largest of 10 numbers. user inputs 10 numbers and program gives back the highest number. """


saved_number = int(input("Enter number 1: "))
for i in range(10 - 1):
    num = int(input(f"Enter number {i+2}: "))
    if num > saved_number:
        saved_number = num
    
print("The largest number entered was:", saved_number)
