    def diamond_loop():
        size = 9 # width and hieght 
        center = 4 # middle position 
        for row in range(size):
            line = ""
            for col in range(size):
                if abs(row - center) + abs(col - center) == center:
                    line = line + "*"
                else:
                    line = line + "_"
            print(line)
    if __name__ == "__main__":
        diamond_loop()
