def main():
    print("I'm thinking of a number between 1 and 100. Can you guess it?")
    count = 0
    while True:
        your_guess = int(input("Your guess: "))
        count += 1
        if your_guess == 20:
            print(f"Correct! It took you {count} Guesses")
            break
        elif your_guess > 20:
            print("Too high")
        else:
            print("Too low")
main()        


            