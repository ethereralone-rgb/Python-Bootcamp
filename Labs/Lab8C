import math


def main():
    pass

    first_numb = float(input("Enter the first number: "))
    second_numb = float(input("Enter the second number: ")) 
    ceiling = math.ceil(first_numb)
    floor = math.floor(first_numb)
    absolute_value = math.fabs(first_numb)
    print(f"Ceiling: {ceiling:.3f}")
    print(f"Floor: {floor:.3f}")
    print(f"Absolute Value: {absolute_value:.3f}")
