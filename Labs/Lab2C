if __name__ == "__main__":
    def formula():
        width = int(input("Enter a width: "))
        height = int(input("Enter a height: "))

        area = round(height * width)
        perimeter = 2*(height + width)

        print(f"The area is {area}")
        print(f"The perimeter is {perimeter}")
if __name__ == "__main__":
        formula()

