"""Write two methods, one returning the area of a rectangle and one returning the perimeter. Call both from your main code and print the results. Neither method may print anything itself."""



def area(length, width):
    area = length * width
    return area 

def perimeter(length, width):
    perimeter = (2 * length) + (2 * width) 
    return perimeter


def main():
    length = int(input("Length: "))
    width = int(input("Width: "))
    print()

    print(f"Area: {area(length, width)}")
    print(f"Perimeter: {perimeter(length, width)}")


if __name__ == "__main__":
    main()
