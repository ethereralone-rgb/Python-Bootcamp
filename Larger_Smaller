def largest(x, y):
    if x > y:
        return x
    return y
def smallest(x, y):
    if x < y:
        return x 
    return y 



def main():
    x = int(input("First number: "))
    y = int(input("Second number: "))
    print()

    print(f"Larger: {largest(x, y)}")
    print(f"Smallest: {smallest(x, y)}")

if __name__ == "__main__":
    main()